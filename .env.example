# Environment & Application
APP_ENV=development
APP_NAME="Multi-Tenant Enterprise RAG Platform"
APP_VERSION=0.1.0
DEBUG=true
PORT=8000

# Security & Authentication (Sprint 1)
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key-with-at-least-32-bytes-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL - Migration Owner (used only for Alembic migrations & DDL)
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_secure_password
POSTGRES_DB=rag_enterprise_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:rag_secure_password@postgres:5432/rag_enterprise_db

# PostgreSQL - Application Runtime Role (NOSUPERUSER, NOBYPASSRLS, used by API engine)
POSTGRES_APP_USER=rag_app
POSTGRES_APP_PASSWORD=rag_app_password
APP_DATABASE_URL=postgresql+asyncpg://rag_app:rag_app_password@postgres:5432/rag_enterprise_db

# Redis (Cache & Rate Limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_DOCUMENTS=tenant-documents
MINIO_SECURE=false

# LLM & Embedding Settings (v1 interfaces)
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_PROVIDER=openai
LLM_API_KEY=mock-or-real-api-key

